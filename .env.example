# Groq (free tier, OpenAI-compatible). Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste_your_key_here
SQL_MODEL=openai/gpt-oss-120b
SUMMARY_MODEL=openai/gpt-oss-20b
REASONING_EFFORT=low

# Optional: paid prices per 1M tokens, only to show an estimated cost (check https://groq.com/pricing)
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0

# Gemini alternative (free tier may use prompts to improve Google products outside EU/UK):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SQL_MODEL=gemini-2.5-flash
# SUMMARY_MODEL=gemini-2.5-flash
